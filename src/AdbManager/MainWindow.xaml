<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AdbManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AdbManager.Models"
    xmlns:controls="using:AdbManager.Controls"
    Title="ADB Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon-64.png" Width="16" Height="16" />
                <TextBlock Text="ADB Manager" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="AppTitleVersion" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Левая панель: adb и устройства ===== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- adb.exe -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="ADB" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="AdbPathText" x:Name="AdbPathText"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Uid="BrowseAdbButton" Click="BrowseAdb_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                                    <TextBlock x:Uid="BrowseAdbText" />
                                </StackPanel>
                            </Button>
                            <Button x:Uid="DownloadAdbButton" x:Name="DownloadAdbButton" Click="DownloadAdb_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock x:Uid="DownloadAdbText" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Заголовок списка устройств -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock x:Uid="DevicesHeader" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Uid="RefreshDevicesButton" HorizontalAlignment="Right" Click="RefreshDevices_Click"
                                Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView x:Name="DevicesList"
                                  ItemsSource="{x:Bind Devices}"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="DevicesList_ItemClick"
                                  SelectionChanged="DevicesList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DeviceInfo">
                                    <Grid ColumnSpacing="12" Padding="0,8" Opacity="{x:Bind ItemOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="{x:Bind TypeText}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind SubtitleText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind StateText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Uid="NoDevicesText" x:Name="NoDevicesText"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Действия с выбранным устройством -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                        <Button x:Uid="EnableWifiButton" x:Name="EnableWifiButton" Click="EnableWifi_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE701;" FontSize="14" />
                                <TextBlock x:Uid="EnableWifiText" />
                            </StackPanel>
                        </Button>
                        <Button x:Uid="DisconnectButton" x:Name="DisconnectButton" Click="Disconnect_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8CD;" FontSize="14" />
                                <TextBlock x:Uid="DisconnectButtonText" x:Name="DisconnectButtonText" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Подключение по сети -->
                    <StackPanel Grid.Row="4" Spacing="6">
                        <TextBlock x:Uid="ConnectHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ConnectAddressBox" PlaceholderText="192.168.1.10:5555" KeyDown="ConnectAddressBox_KeyDown" />
                            <Button x:Uid="ConnectButton" Grid.Column="1" Click="Connect_Click" Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <HyperlinkButton x:Uid="FindInNetworkButton" x:Name="FindInNetworkButton" Click="FindInNetwork_Click" Padding="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                                    <TextBlock x:Uid="FindInNetworkText" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton x:Uid="PairButton" Click="Pair_Click" Padding="0,4" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Правая панель: приложения ===== -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="PackagesHeader" x:Name="PackagesHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="PackagesCountText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="MetadataProgressPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                    <ProgressRing IsActive="True" Width="12" Height="12" />
                                    <TextBlock x:Name="MetadataProgressText" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                            <AppBarButton x:Uid="InstallButton" x:Name="InstallButton" Click="Install_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Uid="UninstallButton" x:Name="UninstallButton" Click="Uninstall_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Uid="FreezeButton" x:Name="FreezeButton" Click="Freeze_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE769;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Uid="UnfreezeButton" x:Name="UnfreezeButton" Click="Unfreeze_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE768;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Uid="RefreshPackagesButton" x:Name="RefreshPackagesButton" Click="RefreshPackages_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton x:Uid="PullApkButton" x:Name="PullApkButton" Click="PullApk_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Uid="CopyListButton" x:Name="CopyListButton" Click="CopyListForLlm_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Uid="CopyNameButton" x:Name="CopyNameButton" Click="CopyName_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton x:Uid="RestoreButton" x:Name="RestoreButton" Click="Restore_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE7A7;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Uid="RestoreRemovedButton" x:Name="RestoreRemovedButton" Click="RestoreRemoved_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE777;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Uid="CheckDriftButton" x:Name="CheckDriftButton" Click="CheckDrift_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE895;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton x:Uid="InstallLauncherButton" x:Name="InstallLauncherButton" Click="InstallLauncher_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE80F;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Uid="PrivacyAuditButton" x:Name="PrivacyAuditButton" Click="PrivacyAudit_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE720;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Uid="PrivateDnsButton" x:Name="PrivateDnsButton" Click="PrivateDns_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE72E;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Uid="OpenBackupsButton" x:Name="OpenBackupsButton" Click="OpenBackups_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Uid="ScreenshotButton" x:Name="ScreenshotButton" Click="Screenshot_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE722;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarToggleButton x:Uid="ExpertModeButton" x:Name="ExpertModeButton" Click="ExpertMode_Click">
                                    <AppBarToggleButton.Icon>
                                        <FontIcon Glyph="&#xE7BA;" />
                                    </AppBarToggleButton.Icon>
                                </AppBarToggleButton>
                                <AppBarButton x:Uid="McpButton" x:Name="McpButton" Click="Mcp_Click">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE99A;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton x:Uid="CheckUpdatesButton" x:Name="CheckUpdatesButton" Click="CheckUpdates_Click">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE895;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Uid="AboutButton" x:Name="AboutButton" Click="About_Click">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE946;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Uid="LanguageButton" x:Name="LanguageButton">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xF2B7;" />
                                    </AppBarButton.Icon>
                                    <AppBarButton.Flyout>
                                        <MenuFlyout>
                                            <RadioMenuFlyoutItem x:Uid="LanguageSystemItem" x:Name="LanguageSystemItem" Tag="" GroupName="Language" Click="Language_Click" />
                                            <!-- Названия языков — на самих языках, не переводятся -->
                                            <RadioMenuFlyoutItem x:Name="LanguageRussianItem" Text="Русский" Tag="ru-RU" GroupName="Language" Click="Language_Click" />
                                            <RadioMenuFlyoutItem x:Name="LanguageEnglishItem" Text="English" Tag="en-US" GroupName="Language" Click="Language_Click" />
                                        </MenuFlyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Uid="SearchBox" x:Name="SearchBox"
                                        QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
                        <DropDownButton x:Uid="MarkButton" x:Name="MarkButton" Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73A;" FontSize="14" />
                                <TextBlock x:Uid="MarkButtonText" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="MarkFlyout_Opening">
                                    <MenuFlyoutItem x:Uid="MarkAllItem" Tag="All" Click="Mark_Click" />
                                    <MenuFlyoutItem x:Uid="MarkEnabledItem" Tag="Enabled" Click="Mark_Click" />
                                    <MenuFlyoutItem x:Uid="MarkFrozenItem" Tag="Frozen" Click="Mark_Click" />
                                    <MenuFlyoutItem x:Uid="MarkUnusedItem" Tag="Unused" Click="Mark_Click" />
                                    <MenuFlyoutItem x:Uid="MarkUserItem" Tag="User" Click="Mark_Click" />
                                    <MenuFlyoutItem x:Uid="MarkSystemItem" Tag="System" Click="Mark_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Uid="MarkRecommendedItem" Tag="Recommended" Click="Mark_Click" />
                                    <MenuFlyoutSubItem x:Uid="PresetsMenu" x:Name="PresetsMenu">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon Glyph="&#xE728;" />
                                        </MenuFlyoutSubItem.Icon>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Uid="MarkInvertItem" Tag="Invert" Click="Mark_Click" />
                                    <MenuFlyoutItem x:Uid="MarkNoneItem" Tag="None" Click="Mark_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <ToggleSwitch x:Uid="ShowSystemToggle" x:Name="ShowSystemToggle" Grid.Column="2"
                                      Toggled="ShowSystemToggle_Toggled" MinWidth="0" />
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="4">
                        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />
                        <InfoBar x:Uid="ExpertModeBar" x:Name="ExpertModeBar" IsOpen="False" IsClosable="False" Severity="Error">
                            <InfoBar.ActionButton>
                                <Button x:Uid="DisableExpertModeButton" Click="DisableExpertMode_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <!-- Новая версия программы: крестик — больше не напоминать об этой версии -->
                        <InfoBar x:Uid="UpdateBar" x:Name="UpdateBar" IsOpen="False" IsClosable="True" Severity="Informational"
                                 CloseButtonClick="UpdateBar_CloseButtonClick">
                            <InfoBar.ActionButton>
                                <Button x:Uid="UpdateDownloadButton" Click="UpdateDownload_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Шапка таблицы: клик по колонке — сортировка, повторный клик — в обратном порядке -->
                        <Grid x:Name="PackagesHeaderRow" ColumnSpacing="12" Margin="12,0,16,4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <!-- Отметить / снять все показанные; промежуточное состояние — отмечена часть -->
                            <CheckBox x:Uid="SelectAllCheckBox" x:Name="SelectAllCheckBox" MinWidth="0" Width="20" Padding="0"
                                      IsThreeState="False" VerticalAlignment="Center"
                                      Click="SelectAllCheckBox_Click" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="-8,0,0,0">
                                <Button x:Name="SortByNameButton" Tag="Name" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Uid="SortByNameText" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <FontIcon x:Name="SortByNameArrow" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SortByPackageButton" Tag="Package" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Uid="SortByPackageText" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <FontIcon x:Name="SortByPackageArrow" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="3" Tag="Status" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Uid="SortByStatusText" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <FontIcon x:Name="SortByStatusArrow" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button x:Uid="SortByAdviceButton" Grid.Column="4" Tag="Advice" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Uid="SortByAdviceText" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <FontIcon x:Name="SortByAdviceArrow" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="5" Tag="Kind" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Uid="SortByKindText" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <FontIcon x:Name="SortByKindArrow" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="6" Tag="Size" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                    HorizontalAlignment="Right" Margin="0,0,-8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="SortBySizeArrow" FontSize="10" />
                                    <TextBlock x:Uid="SortBySizeText" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView x:Name="PackagesList" Grid.Row="1"
                                  ItemsSource="{x:Bind Packages}"
                                  SelectionMode="Multiple"
                                  SelectionChanged="PackagesList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PackageInfo">
                                    <Grid ColumnSpacing="12" Padding="0,6" ToolTipService.ToolTip="{x:Bind ApkPath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <controls:AppIconView Width="36" Height="36" VerticalAlignment="Center"
                                                              Icon="{x:Bind Icon, Mode=OneWay}"
                                                              FallbackGlyph="{x:Bind Glyph}"
                                                              Opacity="{x:Bind IconOpacity, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Border x:Uid="UnusedBadge" Visibility="{x:Bind IsUnused, Mode=OneWay}"
                                                    Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                                    CornerRadius="4" Padding="8,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE708;" FontSize="10"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Uid="UnusedBadgeText" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Visibility="{x:Bind IsFrozen, Mode=OneWay}"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="4" Padding="8,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE769;" FontSize="10"
                                                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                    <TextBlock x:Uid="FrozenBadgeText" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <!-- Совет: цвет по типу, пояснение — в подсказке -->
                                        <Grid Grid.Column="3" VerticalAlignment="Center" Background="Transparent"
                                              ToolTipService.ToolTip="{x:Bind AdviceToolTip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsAdviceDisable, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                <TextBlock Text="{x:Bind AdviceText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsAdviceOptional, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE897;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind AdviceText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsAdviceBlocked, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="{x:Bind AdviceText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="4" Text="{x:Bind KindText}" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   ToolTipService.ToolTip="{x:Bind SizeToolTip, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyPackagesPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8EA;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Uid="EmptyPackagesText" x:Name="EmptyPackagesText"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="DropApkHint"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Журнал команд -->
        <Expander x:Uid="LogExpander" Grid.Row="2" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Margin="12,0,12,12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="180" FontFamily="Cascadia Mono, Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button x:Uid="ClearLogButton" Grid.Row="1" Click="ClearLog_Click" HorizontalAlignment="Right" />
            </Grid>
        </Expander>
    </Grid>
</Window>
