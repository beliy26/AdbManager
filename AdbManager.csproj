<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AdbManager</RootNamespace>
    <AssemblyName>AdbManager</AssemblyName>
    <Version>1.0.0</Version>
    <Product>ADB Manager</Product>
    <Description>Управление приложениями Android по ADB</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Неупакованное приложение: запускается как обычный .exe, без MSIX -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Нужно и без MSIX: иначе dotnet publish не кладёт AdbManager.pri и *.xbf (скомпилированный XAML) -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Вместо метапакета Microsoft.WindowsAppSDK — только нужные компоненты: метапакет тянет
      ещё AI/ML/Search/Widgets (onnxruntime, DirectML…), что добавляет ~40 МБ к сборке.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иконка окна и заголовка (иконка exe задаётся через ApplicationIcon) -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon-64.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\AppIcon.png" />
  </ItemGroup>

  <!--
    В self-contained режиме Windows App SDK добавляет сотни своих DLL/winmd как элементы None
    со ссылкой (Link), и IDE показывают их в дереве проекта (Rider игнорирует Visible=false
    для элементов из таргетов). При design-time сборке IDE (BuildingProject != true) убираем их;
    при настоящей сборке они остаются и копируются в выходную папку как обычно.
  -->
  <Target Name="HideWindowsAppSDKPayloadInIde"
          AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents"
          Condition="'$(BuildingProject)' != 'true'">
    <ItemGroup>
      <None Remove="@(MicrosoftWindowsAppSDKFiles)" />
    </ItemGroup>
  </Target>

</Project>
