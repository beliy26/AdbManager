<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AdbManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AdbManager.Models"
    xmlns:controls="using:AdbManager.Controls"
    Title="ADB Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon-64.png" Width="16" Height="16" />
                <TextBlock Text="ADB Manager" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Левая панель: adb и устройства ===== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- adb.exe -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="ADB" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="AdbPathText"
                                   Text="adb.exe не найден"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Click="BrowseAdb_Click" ToolTipService.ToolTip="Указать путь к adb.exe">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                                    <TextBlock Text="Указать" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DownloadAdbButton" Click="DownloadAdb_Click"
                                    ToolTipService.ToolTip="Скачать Android platform-tools с dl.google.com">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Скачать" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Заголовок списка устройств -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="Устройства" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Click="RefreshDevices_Click"
                                ToolTipService.ToolTip="Обновить список устройств"
                                Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView x:Name="DevicesList"
                                  ItemsSource="{x:Bind Devices}"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="DevicesList_ItemClick"
                                  SelectionChanged="DevicesList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DeviceInfo">
                                    <Grid ColumnSpacing="12" Padding="0,8" Opacity="{x:Bind ItemOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="{x:Bind KindText}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind SubtitleText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind StateText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoDevicesText"
                                   Text="Нет устройств.&#x0a;Подключите телефон по USB с включённой «Отладкой по USB», нажмите «Найти в сети» или выполните сопряжение по коду."
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Действия с выбранным устройством -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="EnableWifiButton" Click="EnableWifi_Click" IsEnabled="False"
                                ToolTipService.ToolTip="Перевести USB-устройство в режим отладки по Wi-Fi (adb tcpip 5555)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE701;" FontSize="14" />
                                <TextBlock Text="Wi-Fi режим" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DisconnectButton" Click="Disconnect_Click" IsEnabled="False"
                                ToolTipService.ToolTip="Отключить беспроводное устройство или забыть сопряжённое">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8CD;" FontSize="14" />
                                <TextBlock x:Name="DisconnectButtonText" Text="Отключить" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Подключение по сети -->
                    <StackPanel Grid.Row="4" Spacing="6">
                        <TextBlock Text="Подключение по Wi-Fi" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ConnectAddressBox" PlaceholderText="192.168.1.10:5555" KeyDown="ConnectAddressBox_KeyDown" />
                            <Button Grid.Column="1" Content="Подключить" Click="Connect_Click" Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <HyperlinkButton x:Name="FindInNetworkButton" Click="FindInNetwork_Click" Padding="0,4"
                                             ToolTipService.ToolTip="Ищет устройства с отладкой по сети (порт 5555 в домашней сети и беспроводную отладку Android 11+ по mDNS) и добавляет их в список">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                                    <TextBlock Text="Найти в сети" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Content="Сопряжение по коду…" Click="Pair_Click" Padding="0,4"
                                             ToolTipService.ToolTip="Беспроводная отладка Android 11+: подключение по коду" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Правая панель: приложения ===== -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PackagesHeader" Text="Приложения" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="PackagesCountText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="MetadataProgressPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                    <ProgressRing IsActive="True" Width="12" Height="12" />
                                    <TextBlock x:Name="MetadataProgressText" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                            <AppBarButton x:Name="InstallButton" Label="Установить APK" Click="Install_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="UninstallButton" Label="Удалить" Click="Uninstall_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="FreezeButton" Label="Заморозить" Click="Freeze_Click" IsEnabled="False"
                                          ToolTipService.ToolTip="Отключить приложение (pm disable-user). Данные сохраняются.">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE769;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="UnfreezeButton" Label="Включить" Click="Unfreeze_Click" IsEnabled="False"
                                          ToolTipService.ToolTip="Разморозить приложение или включить остановленное системой">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE768;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="RefreshPackagesButton" Label="Обновить" Click="RefreshPackages_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton x:Name="PullApkButton" Label="Сохранить APK на ПК…" Click="PullApk_Click" IsEnabled="False"
                                              ToolTipService.ToolTip="Одно приложение — в выбранный файл, несколько отмеченных — в выбранную папку (файлы по имени пакета)">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="CopyListButton" Label="Копировать список для LLM" Click="CopyListForLlm_Click" IsEnabled="False"
                                              ToolTipService.ToolTip="Скопировать показанный список приложений (с учётом поиска и фильтров) в виде таблицы с запросом для консультации у ИИ">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="CopyNameButton" Label="Копировать имя пакета" Click="CopyName_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton x:Name="RestoreButton" Label="Вернуть как было…" Click="Restore_Click" IsEnabled="False"
                                              ToolTipService.ToolTip="Отменить заморозку, удаление системных приложений и смену DNS, сделанные этой программой">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE7A7;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="RestoreRemovedButton" Label="Восстановить удалённые системные…" Click="RestoreRemoved_Click" IsEnabled="False"
                                              ToolTipService.ToolTip="Системные приложения, удалённые для пользователя (кем угодно), возвращаются через install-existing">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE777;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="CheckDriftButton" Label="Проверить после обновления прошивки…" Click="CheckDrift_Click" IsEnabled="False"
                                              ToolTipService.ToolTip="Обновление прошивки возвращает замороженное и удалённое — найти такие приложения и повторить">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE895;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton x:Name="InstallLauncherButton" Label="Установить лаунчер Projectivy…" Click="InstallLauncher_Click" IsEnabled="False"
                                              ToolTipService.ToolTip="Скачать с GitHub и установить Projectivy Launcher — главный экран для Android TV без рекламы">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE80F;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="PrivacyAuditButton" Label="Аудит приватности…" Click="PrivacyAudit_Click" IsEnabled="False"
                                              ToolTipService.ToolTip="Голосовой ассистент, доступ к микрофону по истории AppOps, ACR и телеметрия">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE720;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="PrivateDnsButton" Label="Частный DNS (блокировка рекламы)…" Click="PrivateDns_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE72E;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="OpenBackupsButton" Label="Открыть папку бэкапов и журнала" Click="OpenBackups_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="ScreenshotButton" Label="Снимок экрана устройства…" Click="Screenshot_Click" IsEnabled="False">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE722;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Поиск по названию или имени пакета"
                                        QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
                        <DropDownButton x:Name="MarkButton" Grid.Column="1" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Быстро отметить приложения среди показанных">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73A;" FontSize="14" />
                                <TextBlock Text="Отметить" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Все" Tag="All" Click="Mark_Click" />
                                    <MenuFlyoutItem Text="Включённые" Tag="Enabled" Click="Mark_Click" />
                                    <MenuFlyoutItem Text="Замороженные" Tag="Frozen" Click="Mark_Click" />
                                    <MenuFlyoutItem Text="Не используемые" Tag="Unused" Click="Mark_Click" />
                                    <MenuFlyoutItem Text="Пользовательские" Tag="User" Click="Mark_Click" />
                                    <MenuFlyoutItem Text="Системные" Tag="System" Click="Mark_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Рекомендуемые к отключению" Tag="Recommended" Click="Mark_Click"
                                                    ToolTipService.ToolTip="Включённые приложения, которые советуется отключить: реклама, телеметрия, скрытые установщики (база ЧистогоТВ и список предустановок телефонов)" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Инвертировать" Tag="Invert" Click="Mark_Click" />
                                    <MenuFlyoutItem Text="Снять отметку" Tag="None" Click="Mark_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <ToggleSwitch x:Name="ShowSystemToggle" Grid.Column="2"
                                      OnContent="Системные: показаны" OffContent="Системные: скрыты"
                                      Toggled="ShowSystemToggle_Toggled" MinWidth="0" />
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="4">
                        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />
                        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Шапка таблицы: клик по колонке — сортировка, повторный клик — в обратном порядке -->
                        <Grid x:Name="PackagesHeaderRow" ColumnSpacing="12" Margin="12,0,16,4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <!-- Отметить / снять все показанные; промежуточное состояние — отмечена часть -->
                            <CheckBox x:Name="SelectAllCheckBox" MinWidth="0" Width="20" Padding="0"
                                      IsThreeState="False" VerticalAlignment="Center"
                                      Click="SelectAllCheckBox_Click"
                                      ToolTipService.ToolTip="Отметить все показанные приложения" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="-8,0,0,0">
                                <Button x:Name="SortByNameButton" Tag="Name" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Название" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <FontIcon x:Name="SortByNameArrow" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SortByPackageButton" Tag="Package" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Пакет" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <FontIcon x:Name="SortByPackageArrow" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="3" Tag="Status" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Статус" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <FontIcon x:Name="SortByStatusArrow" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Tag="Advice" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,0"
                                    ToolTipService.ToolTip="Совет из базы ЧистогоТВ и списка рекламных предустановок телефонов; встроенная защита критичных системных пакетов">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Совет" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <FontIcon x:Name="SortByAdviceArrow" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="5" Tag="Kind" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Тип" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <FontIcon x:Name="SortByKindArrow" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="6" Tag="Size" Click="SortHeader_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                    HorizontalAlignment="Right" Margin="0,0,-8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="SortBySizeArrow" FontSize="10" />
                                    <TextBlock Text="Размер" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView x:Name="PackagesList" Grid.Row="1"
                                  ItemsSource="{x:Bind Packages}"
                                  SelectionMode="Multiple"
                                  SelectionChanged="PackagesList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PackageInfo">
                                    <Grid ColumnSpacing="12" Padding="0,6" ToolTipService.ToolTip="{x:Bind ApkPath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <controls:AppIconView Width="36" Height="36" VerticalAlignment="Center"
                                                              Icon="{x:Bind Icon, Mode=OneWay}"
                                                              FallbackGlyph="{x:Bind Glyph}"
                                                              Opacity="{x:Bind IconOpacity, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Border Visibility="{x:Bind IsUnused, Mode=OneWay}"
                                                    Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                                    CornerRadius="4" Padding="8,2"
                                                    ToolTipService.ToolTip="Android остановил приложение, так как им давно не пользовались. Оно включится при запуске.">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE708;" FontSize="10"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="Не используется" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Visibility="{x:Bind IsFrozen, Mode=OneWay}"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="4" Padding="8,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE769;" FontSize="10"
                                                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                    <TextBlock Text="Заморожено" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <!-- Совет: цвет по типу, пояснение — в подсказке -->
                                        <Grid Grid.Column="3" VerticalAlignment="Center" Background="Transparent"
                                              ToolTipService.ToolTip="{x:Bind AdviceToolTip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsAdviceDisable, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                <TextBlock Text="{x:Bind AdviceText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsAdviceOptional, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE897;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind AdviceText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsAdviceBlocked, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="{x:Bind AdviceText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="4" Text="{x:Bind KindText}" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   ToolTipService.ToolTip="{x:Bind SizeToolTip, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyPackagesPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8EA;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="EmptyPackagesText" Text="Выберите устройство слева"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="APK-файлы можно перетащить в окно для установки"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Журнал команд -->
        <Expander Grid.Row="2" Header="Журнал adb" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Margin="12,0,12,12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="180" FontFamily="Cascadia Mono, Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button Grid.Row="1" Content="Очистить" Click="ClearLog_Click" HorizontalAlignment="Right" />
            </Grid>
        </Expander>
    </Grid>
</Window>
